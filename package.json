{
    "name": "abdelmouhaimine-portfolio",
    "private": true,
    "version": "2.0.0",
    "type": "module",
    "scripts": {
        "dev": "vite --host 127.0.0.1",
        "build": "tsc -b && vite build",
        "preview": "vite preview --host 127.0.0.1",
        "typecheck": "tsc -b",
        "format": "prettier --write src index.html vite.config.ts tsconfig.json package.json README.md",
        "format:check": "prettier --check src index.html vite.config.ts tsconfig.json package.json README.md",
        "test": "node --experimental-strip-types --test tests/*.test.mjs"
    },
    "dependencies": {
        "react": "^19.2.0",
        "react-dom": "^19.2.0"
    },
    "devDependencies": {
        "@types/react": "^19.2.0",
        "@types/react-dom": "^19.2.0",
        "@vitejs/plugin-react": "^5.1.0",
        "prettier": "^3.9.10",
        "typescript": "~5.9.3",
        "vite": "^7.2.0"
    }
}
